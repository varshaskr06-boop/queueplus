# ==============================================================================
# QueuePulse AI - Express Backend Production Environment Template (e.g. Render)
# ==============================================================================
PORT=10000
NODE_ENV=production

# Production PostgreSQL Database URL (e.g. Render PostgreSQL, Supabase, Neon)
# Example: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require"

# Direct URL for Prisma Migrations if using connection pooler (e.g. Supabase port 5432)
# DIRECT_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require"

# Hosted Python FastAPI ML Prediction Service URL (e.g. on Render)
ML_SERVICE_URL="https://queuepulse-ml.onrender.com"

# Production Frontend Allowed Origins (Comma-separated for multiple domains)
CORS_ORIGIN="https://queuepulse.vercel.app,https://queuepulse-ai.vercel.app"

# Cryptographically Secure JWT Secret (Generate with: openssl rand -hex 32)
JWT_SECRET="<CHANGE_TO_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY>"
JWT_EXPIRES_IN="7d"

# Password hashing cost in production
BCRYPT_SALT_ROUNDS=12
