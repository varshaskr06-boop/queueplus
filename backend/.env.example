# ==============================================================================
# QueuePulse AI - Express Backend Local Environment Template
# ==============================================================================
PORT=5000
NODE_ENV=development

# PostgreSQL connection string for local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/queuepulse_db?schema=public"

# Python FastAPI Machine Learning Service URL
ML_SERVICE_URL="http://localhost:8000"

# Allowed web origins for CORS (comma-separated if multiple)
CORS_ORIGIN="http://localhost:5173"

# JWT configuration
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"

# Password hashing configuration
BCRYPT_SALT_ROUNDS=10
