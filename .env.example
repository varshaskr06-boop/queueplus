# ==============================================================================
# QueuePulse AI - Root Master Environment Variable Template
# ==============================================================================

# Backend (Express / Node.js)
BACKEND_PORT=5000
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/queuepulse_db?schema=public"
JWT_SECRET="<CHANGE_TO_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY>"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# ML Prediction Service (Python / FastAPI)
ML_PORT=8000
ML_SERVICE_URL="http://localhost:8000"

# Frontend Client (React / Vite)
FRONTEND_PORT=5173
VITE_API_BASE_URL="http://localhost:5000"
VITE_ML_SERVICE_URL="http://localhost:8000"
